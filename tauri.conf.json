{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SENTINEL",
  "version": "0.1.4",
  "identifier": "io.sentinel.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SENTINEL — System Command Centre",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:"
    }
  },
  "bundle": {
    "active": true,
    "category": "Utility",
    "shortDescription": "Linux system health and security command centre",
    "targets": ["deb"]
  }
}
